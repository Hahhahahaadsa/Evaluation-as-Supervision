# ---------------------------------------------------------------------------
# LOCAL LLM PROFILE - Ollama (OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
# Satisfies the Option-D requirement to run the agents against a locally-hosted
# LLM (the cloud profile lives in .env.example). Copy this to .env to use it:
#
#   cp backend/.env.local.example backend/.env
#
# Prerequisites (see docs/LOCAL_LLM.md):
#   1. Install Ollama:            https://ollama.com/download
#   2. Pull a model:              ollama pull llama3.1
#   3. Ollama serves an OpenAI-compatible API on http://localhost:11434/v1
#
# OPENAI_API_KEY is not required for Ollama; the code injects a placeholder for
# local endpoints, but you may set any non-empty value here.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.1
OPENAI_FALLBACK_MODEL=llama3.1

# Dataset paths (repo-root-relative; loader.py resolves them against the repo root).
YELP_BUSINESS_PATH=backend/data/raw/yelp_academic_dataset_business.json
YELP_REVIEW_PATH=backend/data/raw/yelp_academic_dataset_review.json
MAX_REVIEW_SAMPLE=100
RANDOM_SEED=42
