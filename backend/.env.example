# LLM configuration (OpenAI-compatible API).
# The example below targets Gemini's OpenAI-compatible endpoint.
# OPENAI_API_KEY holds a Google AI Studio (Gemini) key — the var name is kept so
# the existing OpenAI client code works unchanged.
# Put your real key in .env (which is git-ignored) — never in this file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash
OPENAI_FALLBACK_MODEL=gemini-3.5-flash

# Dataset paths (repo-root-relative; loader.py resolves them against the repo root).
YELP_BUSINESS_PATH=backend/data/raw/yelp_academic_dataset_business.json
YELP_REVIEW_PATH=backend/data/raw/yelp_academic_dataset_review.json
MAX_REVIEW_SAMPLE=100
RANDOM_SEED=42
